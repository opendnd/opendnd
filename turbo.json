{
  "globalEnv": [
    "BRANCH_NAME"
  ],
  "ui": "stream",
  "dangerouslyDisablePackageManagerCheck": false,
  "cacheDir": ".turbo/cache",
  "envMode": "strict",
  "concurrency": "20",
  "tasks": {
    "turbo:build": {
      "dependsOn": [
        "^turbo:build"
      ],
      "env": [],
      "passThroughEnv": [],
      "outputs": [],
      "cache": true,
      "inputs": [
        ".projen/**",
        "!.DS_Store",
        "!**/.DS_Store"
      ],
      "outputLogs": "new-only",
      "persistent": false,
      "interactive": false
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "cache": true
    },
    "test": {
      "cache": true
    },
    "test:ci": {
      "cache": true,
      "outputs": [
        "test-results.xml"
      ]
    },
    "lint": {
      "cache": true
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "inputs": [
        ".env",
        ".env.local"
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.js and run \"bunx projen\"."
}
