{
  "$id": "https://example.test/ours/schemas/pet.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pet",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/Base"
    }
  ],
  "properties": {
    "mood": {
      "$ref": "../vocabularies/mood.schema.json",
      "default": "happy"
    },
    "owner": {
      "$ref": "common.schema.json#/$defs/Reference"
    },
    "legs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "nicknames": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "born": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    }
  },
  "required": [
    "legs"
  ]
}
