{
  "resourceType": "Vocabulary",
  "id": "succession-law",
  "url": "https://docs.opendnd.org/ours/vocabularies/succession-law.json",
  "version": "0.1.0",
  "system": "internal",
  "name": "Succession law",
  "description": "How a title passes from holder to holder.",
  "codes": [
    {
      "code": "primogeniture",
      "display": "Primogeniture",
      "definition": "Eldest child first, then that child's line, regardless of sex."
    },
    {
      "code": "male-preference",
      "display": "Male-preference primogeniture",
      "definition": "Sons and their lines before daughters and theirs."
    },
    {
      "code": "agnatic",
      "display": "Agnatic",
      "definition": "Male heirs only."
    },
    {
      "code": "seniority",
      "display": "Seniority",
      "definition": "The eldest living member of the house."
    },
    {
      "code": "elective",
      "display": "Elective",
      "definition": "Chosen from the adult members of the organization."
    },
    {
      "code": "appointed",
      "display": "Appointed",
      "definition": "Named by the holder of another title."
    }
  ]
}
