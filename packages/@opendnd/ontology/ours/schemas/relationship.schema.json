{
  "$id": "https://docs.opendnd.org/ours/schemas/relationship.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relationship",
  "type": "object",
  "description": "A tie between two parties, with dated facts (GEDCOM X Relationship extended for succession and for parties that are not people). Either party may be a person, a faction or a place, so the same record carries a marriage, a house's vassalage to a crown, or a person's membership of a guild.",
  "allOf": [
    {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/ResourceBase"
    }
  ],
  "properties": {
    "relationshipType": {
      "type": "string",
      "x-ours-vocabulary": "https://docs.opendnd.org/ours/vocabularies/relationship-type.json"
    },
    "party1": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference",
      "description": "The first party. For an asymmetric type this is the senior side: the parent, the liege, the mentor."
    },
    "party2": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference",
      "description": "The second party."
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "x-ours-vocabulary": "https://docs.opendnd.org/ours/vocabularies/relationship-fact-type.json"
          },
          "time": {
            "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/TemporalPosition"
          },
          "place": {
            "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      }
    },
    "legitimacy": {
      "type": "string",
      "x-ours-vocabulary": "https://docs.opendnd.org/ours/vocabularies/legitimacy.json"
    },
    "successionOrder": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "relationshipType",
    "party1",
    "party2"
  ],
  "unevaluatedProperties": false
}
