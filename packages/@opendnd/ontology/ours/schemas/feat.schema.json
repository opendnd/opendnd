{
  "$id": "https://docs.opendnd.org/ours/schemas/feat.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feat",
  "type": "object",
  "description": "A talent taken in place of, or alongside, an ability score increase.",
  "allOf": [
    {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/ResourceBase"
    }
  ],
  "properties": {
    "featType": {
      "$ref": "https://docs.opendnd.org/ours/vocabularies/feat-type.schema.json"
    },
    "repeatable": {
      "type": "boolean",
      "description": "Whether it may be taken more than once."
    },
    "prerequisites": {
      "type": "object",
      "properties": {
        "minimumLevel": {
          "type": "integer",
          "minimum": 1
        },
        "featureNamed": {
          "type": "string",
          "description": "A feature the character must already have."
        }
      },
      "required": [],
      "additionalProperties": false,
      "description": "What must be true before it can be taken."
    },
    "prerequisiteOptions": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Choice",
      "description": "A choice among prerequisites, where the rules offer one."
    }
  },
  "required": [],
  "unevaluatedProperties": false
}
