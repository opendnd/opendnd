{
  "$id": "https://docs.opendnd.org/ours/schemas/economy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Economy",
  "type": "object",
  "description": "A snapshot of a settlement's economy at a point in time: prosperity, how many of each business it supports, and its livestock. Like population, an aggregate that individuals are drawn from on demand.",
  "allOf": [
    {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/ResourceBase"
    }
  ],
  "properties": {
    "place": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
    },
    "at": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/TemporalPosition"
    },
    "prosperity": {
      "$ref": "https://docs.opendnd.org/ours/vocabularies/prosperity.schema.json"
    },
    "industries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "industry": {
            "$ref": "https://docs.opendnd.org/ours/vocabularies/industry.schema.json"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "industry",
          "count"
        ],
        "additionalProperties": false
      }
    },
    "livestock": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "animal": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "animal",
          "count"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "place",
    "at",
    "prosperity"
  ],
  "unevaluatedProperties": false
}
