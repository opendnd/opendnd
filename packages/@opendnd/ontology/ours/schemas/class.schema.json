{
  "$id": "https://docs.opendnd.org/ours/schemas/class.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Class",
  "type": "object",
  "description": "An adventuring class, and its subclasses through `subclassOf`. Level progression is held here as a table rather than as one record per level, because a class is read whole.",
  "allOf": [
    {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/ResourceBase"
    }
  ],
  "properties": {
    "hitDie": {
      "type": "integer",
      "description": "Sides of the hit die, e.g. 8 for d8."
    },
    "subclassOf": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference",
      "description": "The class this is a subclass of."
    },
    "primaryAbility": {
      "type": "array",
      "items": {
        "$ref": "https://docs.opendnd.org/ours/vocabularies/ability.schema.json"
      },
      "description": "The abilities the class is built on."
    },
    "savingThrows": {
      "type": "array",
      "items": {
        "$ref": "https://docs.opendnd.org/ours/vocabularies/ability.schema.json"
      },
      "description": "Saving throws it is proficient in."
    },
    "proficiencies": {
      "type": "array",
      "items": {
        "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
      },
      "description": "Proficiencies every member of the class has."
    },
    "proficiencyChoices": {
      "type": "array",
      "items": {
        "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Choice"
      },
      "description": "Proficiencies chosen on taking the class."
    },
    "startingEquipmentOptions": {
      "type": "array",
      "items": {
        "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Choice"
      },
      "description": "Equipment chosen at the start."
    },
    "multiclassing": {
      "type": "object",
      "properties": {
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ability": {
                "$ref": "https://docs.opendnd.org/ours/vocabularies/ability.schema.json"
              },
              "minimumScore": {
                "type": "integer"
              }
            },
            "required": [
              "ability",
              "minimumScore"
            ],
            "additionalProperties": false
          }
        },
        "proficiencies": {
          "type": "array",
          "items": {
            "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
          }
        }
      },
      "required": [],
      "additionalProperties": false,
      "description": "What is required to take the class as a second one, and what it grants."
    },
    "spellcasting": {
      "type": "object",
      "properties": {
        "level": {
          "type": "integer",
          "description": "The level at which spellcasting begins."
        },
        "ability": {
          "$ref": "https://docs.opendnd.org/ours/vocabularies/ability.schema.json"
        },
        "info": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          },
          "description": "How the class casts, in the rules' own sections."
        }
      },
      "required": [],
      "additionalProperties": false,
      "description": "How the class casts, where it casts."
    },
    "spells": {
      "type": "array",
      "items": {
        "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
      },
      "description": "The spell list the class draws on."
    },
    "levels": {
      "type": "array",
      "description": "What the class gains at each level.",
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 1
          },
          "subclass": {
            "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference",
            "description": "The subclass this row belongs to, for a subclass-specific level."
          },
          "proficiencyBonus": {
            "type": "integer"
          },
          "features": {
            "type": "array",
            "items": {
              "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
            }
          },
          "classSpecific": {
            "type": "object",
            "additionalProperties": true,
            "description": "Counters particular to the class at this level: rage count, sneak attack dice, sorcery points."
          },
          "spellcasting": {
            "type": "object",
            "properties": {
              "cantripsKnown": {
                "type": "integer"
              },
              "preparedSpells": {
                "type": "integer"
              },
              "spellSlots": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                },
                "description": "Slots by spell level, keyed by the level as a string."
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "level"
        ],
        "additionalProperties": false
      }
    },
    "primaryAbilityOptions": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Choice",
      "description": "A choice of primary ability, for a class that offers one."
    }
  },
  "required": [
    "hitDie"
  ],
  "unevaluatedProperties": false
}
