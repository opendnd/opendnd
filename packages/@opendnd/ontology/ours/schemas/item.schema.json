{
  "$id": "https://docs.opendnd.org/ours/schemas/item.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Item",
  "type": "object",
  "description": "A thing that can be owned, carried or used. One model for equipment, magic items and poisons alike, because the rules treat them the same way and only the fields that apply are filled in. The shape follows the 5e SRD equipment tree so content written for it converts without reshaping; the field names are camelCase to match the rest of this ontology, which is a mechanical transform of theirs. A record may describe a kind of thing or one particular thing: an instance names its kind in `instanceOf`, and any field set on the instance overrides the kind's.",
  "allOf": [
    {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/ResourceBase"
    }
  ],
  "properties": {
    "itemCategory": {
      "$ref": "https://docs.opendnd.org/ours/vocabularies/item-category.schema.json"
    },
    "instanceOf": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference",
      "description": "The kind this is one of: a world's named sword points at the longsword it is."
    },
    "owner": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference",
      "description": "Who holds it: a person or a faction."
    },
    "location": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference",
      "description": "Where it is, when nobody is carrying it."
    },
    "contains": {
      "type": "array",
      "items": {
        "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
      },
      "description": "What is inside it, for a container."
    },
    "created": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference",
      "description": "The event that made it: a forging, a gift, a discovery."
    },
    "cost": {
      "type": "object",
      "properties": {
        "quantity": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "description": "Coin denomination, e.g. gp or cp."
        }
      },
      "required": [
        "quantity",
        "unit"
      ],
      "additionalProperties": false,
      "description": "A price in coin."
    },
    "weight": {
      "type": "number",
      "minimum": 0,
      "description": "In pounds."
    },
    "quantity": {
      "type": "integer",
      "minimum": 1
    },
    "rarity": {
      "$ref": "https://docs.opendnd.org/ours/vocabularies/rarity.schema.json"
    },
    "properties": {
      "type": "array",
      "items": {
        "$ref": "https://docs.opendnd.org/ours/vocabularies/weapon-property.schema.json"
      },
      "description": "Weapon properties."
    },
    "mastery": {
      "$ref": "https://docs.opendnd.org/ours/vocabularies/weapon-mastery.schema.json",
      "description": "The mastery property, for a weapon."
    },
    "damage": {
      "type": "object",
      "properties": {
        "damageDice": {
          "type": "string",
          "description": "Dice notation, e.g. 1d8."
        },
        "damageType": {
          "$ref": "https://docs.opendnd.org/ours/vocabularies/damage-type.schema.json"
        }
      },
      "required": [],
      "additionalProperties": false,
      "description": "Damage as dice and a type."
    },
    "twoHandedDamage": {
      "type": "object",
      "properties": {
        "damageDice": {
          "type": "string",
          "description": "Dice notation, e.g. 1d8."
        },
        "damageType": {
          "$ref": "https://docs.opendnd.org/ours/vocabularies/damage-type.schema.json"
        }
      },
      "required": [],
      "additionalProperties": false,
      "description": "Damage as dice and a type."
    },
    "range": {
      "type": "object",
      "properties": {
        "normal": {
          "type": "integer"
        },
        "long": {
          "type": "integer"
        }
      },
      "required": [
        "normal"
      ],
      "additionalProperties": false,
      "description": "Range in feet."
    },
    "throwRange": {
      "type": "object",
      "properties": {
        "normal": {
          "type": "integer"
        },
        "long": {
          "type": "integer"
        }
      },
      "required": [
        "normal"
      ],
      "additionalProperties": false,
      "description": "Range in feet."
    },
    "ammunition": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference",
      "description": "The item this one is loaded with."
    },
    "armorClass": {
      "type": "object",
      "properties": {
        "base": {
          "type": "integer"
        },
        "dexBonus": {
          "type": "boolean"
        },
        "maxBonus": {
          "type": "integer"
        }
      },
      "required": [
        "base"
      ],
      "additionalProperties": false,
      "description": "Armor class it confers."
    },
    "strengthMinimum": {
      "type": "integer",
      "description": "Strength needed to wear it without penalty."
    },
    "stealthDisadvantage": {
      "type": "boolean"
    },
    "donTime": {
      "type": "string"
    },
    "doffTime": {
      "type": "string"
    },
    "ability": {
      "$ref": "https://docs.opendnd.org/ours/vocabularies/ability.schema.json",
      "description": "The ability a tool is used with."
    },
    "utilize": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "dc": {
            "type": "integer"
          },
          "ability": {
            "$ref": "https://docs.opendnd.org/ours/vocabularies/ability.schema.json"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "description": "What the item can be used to do, and how hard it is."
    },
    "sentient": {
      "type": "boolean",
      "description": "Whether it has a will of its own."
    },
    "attunement": {
      "type": "boolean",
      "description": "Whether it must be attuned to before it works."
    },
    "variant": {
      "type": "boolean",
      "description": "Whether this is one form of a family of items, a +1 sword among +X swords."
    },
    "variants": {
      "type": "array",
      "items": {
        "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
      },
      "description": "The forms this item comes in."
    },
    "limitedTo": {
      "type": "string",
      "description": "Who may use it, where the rules restrict it."
    },
    "poisonType": {
      "$ref": "https://docs.opendnd.org/ours/vocabularies/poison-type.schema.json",
      "description": "How a poison is delivered."
    },
    "image": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": [],
  "unevaluatedProperties": false
}
