{
  "$id": "https://docs.opendnd.org/ours/schemas/spell.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spell",
  "type": "object",
  "description": "A spell. The shape follows the 5e SRD 2024 spell records as published so far (pull request 1178): a single description and higher-level text, damage as a type with dice by slot level, and no subclass lists. The saving throw and area of effect are kept beyond what those records carry, because every spell's rules text has them and a character sheet needs them.",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/ResourceBase"
    }
  ],
  "properties": {
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9,
      "description": "0 is a cantrip."
    },
    "school": {
      "$ref": "../vocabularies/spell-school.schema.json"
    },
    "castingTime": {
      "type": "string"
    },
    "range": {
      "type": "string",
      "description": "As the rules word it: self, touch, 60 feet."
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "V",
          "S",
          "M"
        ]
      }
    },
    "material": {
      "type": "string",
      "description": "What the material component is."
    },
    "duration": {
      "type": "string"
    },
    "concentration": {
      "type": "boolean"
    },
    "ritual": {
      "type": "boolean"
    },
    "higherLevel": {
      "type": "string",
      "description": "What changes when cast with a higher slot."
    },
    "damage": {
      "type": "object",
      "properties": {
        "damageType": {
          "$ref": "../vocabularies/damage-type.schema.json"
        },
        "atSlotLevel": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Damage dice by slot level, keyed by the level as a string."
        }
      },
      "required": [],
      "additionalProperties": false,
      "description": "What it deals, and how that scales."
    },
    "savingThrow": {
      "type": "object",
      "properties": {
        "ability": {
          "$ref": "../vocabularies/ability.schema.json"
        },
        "onSuccess": {
          "type": "string",
          "description": "What happens on a successful save: none, half."
        },
        "description": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false,
      "description": "The save it allows, if any."
    },
    "attackType": {
      "type": "string",
      "enum": [
        "melee",
        "ranged"
      ]
    },
    "areaOfEffect": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "sphere",
            "cube",
            "cylinder",
            "cone",
            "line"
          ]
        },
        "size": {
          "type": "integer"
        }
      },
      "required": [
        "type",
        "size"
      ],
      "additionalProperties": false
    },
    "classes": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Reference"
      },
      "description": "The classes whose lists it appears on."
    }
  },
  "required": [
    "level"
  ],
  "unevaluatedProperties": false
}
