{
  "$id": "https://docs.opendnd.org/ours/schemas/belief.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Belief",
  "type": "object",
  "description": "A belief held by a person or faction about a proposition, so contested history can be recorded without choosing a winner (CRMinf Belief).",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/ResourceBase"
    }
  ],
  "properties": {
    "holder": {
      "$ref": "common.schema.json#/$defs/Reference"
    },
    "proposition": {
      "type": "string"
    },
    "about": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Reference"
      }
    },
    "value": {
      "$ref": "../vocabularies/belief-value.schema.json"
    },
    "basis": {
      "type": "string",
      "description": "Why the holder believes it: observation, inference, tradition, adoption."
    }
  },
  "required": [
    "holder",
    "proposition",
    "value"
  ],
  "unevaluatedProperties": false
}
