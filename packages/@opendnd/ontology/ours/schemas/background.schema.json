{
  "$id": "https://docs.opendnd.org/ours/schemas/background.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Background",
  "type": "object",
  "description": "Where a character came from before they began adventuring. Follows the 2024 rules, in which a background grants ability score increases and a feat rather than a personality table.",
  "allOf": [
    {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/ResourceBase"
    }
  ],
  "properties": {
    "abilityScore": {
      "type": "array",
      "items": {
        "$ref": "https://docs.opendnd.org/ours/vocabularies/ability.schema.json"
      },
      "description": "The abilities it may raise."
    },
    "feat": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference",
      "description": "The feat it grants."
    },
    "proficiency": {
      "type": "array",
      "items": {
        "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
      },
      "description": "Proficiencies it grants outright."
    },
    "proficiencyChoice": {
      "type": "array",
      "items": {
        "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Choice"
      },
      "description": "Proficiencies chosen from a list."
    },
    "startingEquipmentOption": {
      "type": "array",
      "items": {
        "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Choice"
      },
      "description": "Equipment chosen from a list."
    },
    "featNote": {
      "type": "string",
      "description": "The rules' note on the feat, where there is one."
    }
  },
  "required": [],
  "unevaluatedProperties": false
}
