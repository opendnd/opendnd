{
  "$id": "https://opendnd.org/ours/schemas/world.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "World",
  "description": "A fictional universe: the root every other resource belongs to (Wikidata narrative universe).",
  "allOf": [
    {
      "$ref": "https://opendnd.org/ours/schemas/common.schema.json#/$defs/ResourceBase"
    }
  ],
  "properties": {
    "calendar": {
      "$ref": "https://opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
    },
    "crs": {
      "type": "string",
      "format": "uri",
      "description": "Default coordinate reference system IRI for this world's maps."
    },
    "genre": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "currentTime": {
      "$ref": "https://opendnd.org/ours/schemas/common.schema.json#/$defs/TemporalPosition"
    },
    "owner": {
      "type": "string",
      "description": "User id of the world owner."
    }
  },
  "required": [],
  "additionalProperties": false
}
