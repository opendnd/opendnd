{
  "$id": "https://docs.opendnd.org/ours/schemas/tenure.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tenure",
  "type": "object",
  "description": "One person's time holding a title. The record's validTime is the tenure; a new record starts each time the title changes hands.",
  "allOf": [
    {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/ResourceBase"
    }
  ],
  "properties": {
    "title": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference",
      "description": "The title held."
    },
    "holder": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
    },
    "began": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference",
      "description": "The event that started this tenure (succession, coronation, founding)."
    },
    "ended": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference",
      "description": "The event that ended it (death, abdication, deposition)."
    }
  },
  "required": [
    "title",
    "holder"
  ],
  "unevaluatedProperties": false
}
