{
  "$id": "https://docs.opendnd.org/ours/schemas/event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "type": "object",
  "description": "Something that happened in-world, with participants in roles and optional cause links (schema.org Event, CIDOC E5).",
  "allOf": [
    {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/ResourceBase"
    }
  ],
  "properties": {
    "type": {
      "$ref": "https://docs.opendnd.org/ours/vocabularies/event-type.schema.json"
    },
    "occurred": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/TimeSpan"
    },
    "location": {
      "type": "array",
      "items": {
        "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
      }
    },
    "participant": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actor": {
            "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
          },
          "role": {
            "$ref": "https://docs.opendnd.org/ours/vocabularies/participant-role.schema.json"
          }
        },
        "required": [
          "actor",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "partOf": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
    },
    "causedBy": {
      "type": "array",
      "items": {
        "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
      }
    },
    "outcome": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "occurred"
  ],
  "unevaluatedProperties": false
}
