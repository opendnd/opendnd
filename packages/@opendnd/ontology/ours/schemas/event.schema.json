{
  "$id": "https://docs.opendnd.org/ours/schemas/event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "type": "object",
  "description": "Something that happened in-world, with participants in roles and optional cause links (schema.org Event, CIDOC E5).",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/ResourceBase"
    }
  ],
  "properties": {
    "eventType": {
      "$ref": "../vocabularies/event-type.schema.json"
    },
    "when": {
      "$ref": "common.schema.json#/$defs/TimeSpan"
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Reference"
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actor": {
            "$ref": "common.schema.json#/$defs/Reference"
          },
          "role": {
            "$ref": "../vocabularies/participant-role.schema.json"
          }
        },
        "required": [
          "actor",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "partOf": {
      "$ref": "common.schema.json#/$defs/Reference"
    },
    "causedBy": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Reference"
      }
    },
    "outcome": {
      "type": "string"
    }
  },
  "required": [
    "eventType",
    "when"
  ],
  "unevaluatedProperties": false,
  "x-ours-valid-time": {
    "begin": "when.begin",
    "end": "when.end"
  }
}
