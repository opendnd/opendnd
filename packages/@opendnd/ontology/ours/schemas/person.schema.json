{
  "$id": "https://docs.opendnd.org/ours/schemas/person.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Person",
  "type": "object",
  "description": "A person in the world, real to it or legendary (schema.org Person, CIDOC E21, Wikidata fictional human).",
  "allOf": [
    {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/ResourceBase"
    }
  ],
  "properties": {
    "species": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
    },
    "culture": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
    },
    "sex": {
      "$ref": "https://docs.opendnd.org/ours/vocabularies/sex.schema.json"
    },
    "pronouns": {
      "type": "string"
    },
    "epithet": {
      "type": "string",
      "description": "A byname earned in life, e.g. 'the Bold'. Rendered as 'Name the Bold'."
    },
    "alignment": {
      "$ref": "https://docs.opendnd.org/ours/vocabularies/alignment.schema.json"
    },
    "status": {
      "$ref": "https://docs.opendnd.org/ours/vocabularies/person-status.schema.json",
      "default": "alive"
    },
    "birth": {
      "type": "object",
      "properties": {
        "time": {
          "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/TemporalPosition"
        },
        "place": {
          "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
        }
      },
      "additionalProperties": false
    },
    "death": {
      "type": "object",
      "properties": {
        "time": {
          "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/TemporalPosition"
        },
        "place": {
          "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
        },
        "cause": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "memberOf": {
      "type": "array",
      "items": {
        "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
      }
    },
    "residence": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
    },
    "occupation": {
      "type": "string"
    },
    "standing": {
      "description": "How the person stands with the world's powers, each -100..100.",
      "type": "object",
      "properties": {
        "power": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100,
          "description": "Ability to compel others."
        },
        "honor": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100,
          "description": "Regard among peers and rivals."
        },
        "piety": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100,
          "description": "Regard among the faithful and the gods."
        },
        "reputation": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100,
          "description": "Regard among the common people."
        }
      },
      "additionalProperties": false
    },
    "genome": {
      "description": "Genetic record produced by the genetics generator.",
      "type": "object",
      "properties": {
        "chromosomes": {
          "description": "Chromosome number to allele pair, e.g. '3=9' or 'X1=Y3'.",
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[XY]?[0-9]+=[XY]?[0-9]+$"
          }
        },
        "height": {
          "type": "integer",
          "description": "Inches."
        },
        "weight": {
          "type": "integer",
          "description": "Pounds."
        }
      },
      "required": [
        "chromosomes"
      ],
      "additionalProperties": false
    },
    "phenotype": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gene": {
            "type": "string"
          },
          "expression": {
            "type": "string",
            "description": "What the gene expresses as: blue eyes, a heavy build."
          }
        },
        "required": [
          "gene",
          "expression"
        ],
        "additionalProperties": false
      },
      "description": "The phenotype: what each of this person's genes expresses as. Distinct from a species feature such as darkvision, which is a feature."
    },
    "portrait": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": [],
  "unevaluatedProperties": false
}
