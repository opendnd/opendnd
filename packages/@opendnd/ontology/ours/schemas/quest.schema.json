{
  "$id": "https://docs.opendnd.org/ours/schemas/quest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quest",
  "type": "object",
  "description": "Something a party is meant to do, and how far they have got with it. In-universe as the world's own errand, or out-of-universe as a thread the gamemaster is holding; the perspective field says which.",
  "allOf": [
    {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/ResourceBase"
    }
  ],
  "properties": {
    "status": {
      "$ref": "https://docs.opendnd.org/ours/vocabularies/quest-status.schema.json"
    },
    "campaign": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference",
      "description": "The campaign it belongs to, when it belongs to one."
    },
    "giver": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference",
      "description": "Who set it."
    },
    "objectives": {
      "type": "array",
      "description": "The steps it breaks into, each done or not.",
      "items": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string"
          },
          "done": {
            "type": "boolean",
            "default": false
          },
          "about": {
            "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
          }
        },
        "required": [
          "summary"
        ],
        "additionalProperties": false
      }
    },
    "about": {
      "type": "array",
      "items": {
        "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
      },
      "description": "What it concerns: places, people, factions, other quests."
    },
    "reward": {
      "type": "string"
    },
    "resolvedBy": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference",
      "description": "The event that finished it."
    }
  },
  "required": [
    "status"
  ],
  "unevaluatedProperties": false
}
