{
  "$id": "https://docs.opendnd.org/ours/schemas/place.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Place",
  "type": "object",
  "description": "A location at any scale, optionally with geometry in the world's CRS (schema.org Place, CIDOC E53, GeoSPARQL Feature).",
  "allOf": [
    {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/ResourceBase"
    }
  ],
  "properties": {
    "type": {
      "$ref": "https://docs.opendnd.org/ours/vocabularies/place-type.schema.json"
    },
    "partOf": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
    },
    "feature": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Feature"
    },
    "extent": {
      "type": "array",
      "items": {
        "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Cell"
      },
      "description": "The ground this place holds, as quadtree cells. A border is a curve, which cannot be owned or compared; a set of cells can be. Whether a place holds somewhere is then a prefix test, and when a border moves, cells change hands \u2014 which is what a border moving is. Coarse cells inland, fine ones along the edge. `cell` is where the place is; this is what it covers.",
      "uniqueItems": true
    },
    "cell": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Cell",
      "description": "Quadtree cell token for this place at its own scale (a realm at a coarse level, a building at a fine one). Containment is a prefix relationship. See ADR-006."
    },
    "population": {
      "type": "integer",
      "minimum": 0
    },
    "biome": {
      "type": "string"
    },
    "terrain": {
      "$ref": "https://docs.opendnd.org/ours/vocabularies/terrain.schema.json"
    },
    "resource": {
      "type": "array",
      "items": {
        "$ref": "https://docs.opendnd.org/ours/vocabularies/resource.schema.json"
      },
      "description": "Natural resources the place yields."
    },
    "area": {
      "type": "object",
      "description": "Land in square miles.",
      "properties": {
        "squareMiles": {
          "type": "number",
          "minimum": 0
        },
        "arableSquareMiles": {
          "type": "number",
          "minimum": 0
        },
        "wildernessSquareMiles": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "squareMiles"
      ],
      "additionalProperties": false
    },
    "managingOrganization": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
    },
    "founded": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/TemporalPosition"
    }
  },
  "required": [
    "type"
  ],
  "unevaluatedProperties": false
}
