{
  "$id": "https://docs.opendnd.org/ours/schemas/place.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Place",
  "type": "object",
  "description": "A location at any scale, optionally with geometry in the world's CRS (schema.org Place, CIDOC E53, GeoSPARQL Feature).",
  "allOf": [
    {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/ResourceBase"
    }
  ],
  "properties": {
    "placeType": {
      "type": "string",
      "x-ours-vocabulary": "https://docs.opendnd.org/ours/vocabularies/place-type.json"
    },
    "parent": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
    },
    "feature": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Feature"
    },
    "cell": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Cell",
      "description": "Quadtree cell token for this place at its own scale (a realm at a coarse level, a building at a fine one). Containment is a prefix relationship. See ADR-006."
    },
    "population": {
      "type": "integer",
      "minimum": 0
    },
    "biome": {
      "type": "string"
    },
    "terrain": {
      "type": "string",
      "x-ours-vocabulary": "https://docs.opendnd.org/ours/vocabularies/terrain.json"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string",
        "x-ours-vocabulary": "https://docs.opendnd.org/ours/vocabularies/resource.json"
      },
      "description": "Natural resources the place yields."
    },
    "area": {
      "type": "object",
      "description": "Land in square miles.",
      "properties": {
        "squareMiles": {
          "type": "number",
          "minimum": 0
        },
        "arableSquareMiles": {
          "type": "number",
          "minimum": 0
        },
        "wildernessSquareMiles": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "squareMiles"
      ],
      "additionalProperties": false
    },
    "controlledBy": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
    },
    "founded": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/TemporalPosition"
    }
  },
  "required": [
    "placeType"
  ],
  "unevaluatedProperties": false,
  "x-ours-valid-time": {
    "begin": "founded"
  }
}
