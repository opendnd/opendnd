{
  "$id": "https://docs.opendnd.org/ours/schemas/skill.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill",
  "type": "object",
  "description": "A skill, and the ability its checks are made against.",
  "allOf": [
    {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/ResourceBase"
    }
  ],
  "properties": {
    "ability": {
      "$ref": "https://docs.opendnd.org/ours/vocabularies/ability.schema.json",
      "description": "The ability a check with this skill uses."
    }
  },
  "required": [
    "ability"
  ],
  "unevaluatedProperties": false
}
