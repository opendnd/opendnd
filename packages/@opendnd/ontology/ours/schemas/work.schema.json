{
  "$id": "https://docs.opendnd.org/ours/schemas/work.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Work",
  "type": "object",
  "description": "A creative work, in-world (a chronicle, a legend) or out-of-world (an adventure module) (schema.org CreativeWork; NOnt narration).",
  "allOf": [
    {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/ResourceBase"
    }
  ],
  "properties": {
    "workType": {
      "$ref": "https://docs.opendnd.org/ours/vocabularies/work-type.schema.json"
    },
    "author": {
      "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
    },
    "about": {
      "type": "array",
      "items": {
        "$ref": "https://docs.opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
      }
    },
    "text": {
      "type": "string"
    },
    "language": {
      "type": "string"
    }
  },
  "required": [
    "workType"
  ],
  "unevaluatedProperties": false
}
