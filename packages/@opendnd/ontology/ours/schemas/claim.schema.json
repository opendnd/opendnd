{
  "$id": "https://opendnd.org/ours/schemas/claim.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claim",
  "description": "One person's asserted right to a title. A claim is the seed of a war: it can be pressed, won, lost, or left to descend to an heir.",
  "allOf": [
    {
      "$ref": "https://opendnd.org/ours/schemas/common.schema.json#/$defs/ResourceBase"
    }
  ],
  "properties": {
    "claimant": {
      "$ref": "https://opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
    },
    "title": {
      "$ref": "https://opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
    },
    "basis": {
      "type": "string",
      "x-ours-vocabulary": "https://opendnd.org/ours/vocabularies/claim-basis.json"
    },
    "through": {
      "$ref": "https://opendnd.org/ours/schemas/common.schema.json#/$defs/Reference",
      "description": "The person the claim descends from, when it comes by inheritance or marriage."
    },
    "pressed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the claim has been pressed by force."
    },
    "resolvedBy": {
      "$ref": "https://opendnd.org/ours/schemas/common.schema.json#/$defs/Reference",
      "description": "The event that made the claim good or void."
    }
  },
  "required": [
    "claimant",
    "title",
    "basis"
  ],
  "additionalProperties": false
}
