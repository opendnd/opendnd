{
  "$id": "https://opendnd.org/ours/schemas/faction.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Faction",
  "description": "An organized group of any kind: realm, dynasty, guild, religion, order, company, adventuring party.",
  "allOf": [
    {
      "$ref": "https://opendnd.org/ours/schemas/common.schema.json#/$defs/ResourceBase"
    }
  ],
  "properties": {
    "factionType": {
      "type": "string",
      "x-ours-vocabulary": "https://opendnd.org/ours/vocabularies/faction-type.json"
    },
    "parent": {
      "$ref": "https://opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
    },
    "seat": {
      "$ref": "https://opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
    },
    "leader": {
      "$ref": "https://opendnd.org/ours/schemas/common.schema.json#/$defs/Reference"
    },
    "founded": {
      "$ref": "https://opendnd.org/ours/schemas/common.schema.json#/$defs/TemporalPosition"
    },
    "dissolved": {
      "$ref": "https://opendnd.org/ours/schemas/common.schema.json#/$defs/TemporalPosition"
    },
    "motto": {
      "type": "string"
    },
    "sigil": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": [
    "factionType"
  ],
  "additionalProperties": false
}
